---
import DownloadDialog from '../components/DownloadDialog.astro';

interface Props {
  title: string;
  /** Columna de contenido de la pagina. El toolbar no la comparte: su ritmo es el del chrome. */
  contentMax?: string;
  /** Padding lateral de esa columna. */
  contentPad?: string;
}
const { title, contentMax = '1180px', contentPad = '20px' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="navy" data-accents="name sections urls skills">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={title} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('resume-theme');
          var a = localStorage.getItem('resume-accents');
          var c = localStorage.getItem('resume-theme-custom');
          if (t) document.documentElement.setAttribute('data-theme', t);
          if (a) document.documentElement.setAttribute('data-accents', a);
          if (t === 'custom' && c) document.documentElement.style.setProperty('--accent', c);
        } catch (e) {}
      })();
    </script>
  </head>
  <body style={`--content-max: ${contentMax}; --content-pad: ${contentPad}`}>
    <slot />
    <DownloadDialog />
    <style is:global>
      :root {
        --ink: #1a1a1a;
        --muted: #555;
        --rule: #d0d0d0;
        --bg: #ffffff;
        --accent: #1a365d;
        /* Chrome del sitio (barra superior): ritmo horizontal propio, igual en
           todas las rutas. El toolbar NO hereda el --content-max/--content-pad de
           cada pagina: los anchos de contenido siguen siendo de cada pagina y el
           brand y la nav quedan siempre en el mismo lugar. La alineacion
           barra-contenido (H3d) se conserva en "Mis perfiles", donde el ritmo del
           chrome coincide con la columna del CV (1180px / 20px). */
        --chrome-max: 1180px;
        --chrome-pad: 20px;
      }
      :root[data-theme="navy"] { --accent: #1a365d; }
      :root[data-theme="teal"] { --accent: #0f4c4c; }
      :root[data-theme="charcoal"] { --accent: #333333; }
      :root[data-theme="custom"] { --accent: #1a365d; }

      html[data-accents~="name"] h1 { color: var(--accent); }
      html[data-accents~="sections"] h2 { color: var(--accent); border-bottom-color: var(--accent); }
      html[data-accents~="urls"] .bullets li.proj-url { color: var(--accent); }
      html[data-accents~="skills"] .skill-cat { color: var(--accent); }

      * { box-sizing: border-box; }

      html { -webkit-text-size-adjust: 100%; }

      body {
        margin: 0;
        background: #e9ecef;
        color: var(--ink);
        font-family: 'Helvetica Neue', Helvetica, Arial, Calibri, sans-serif;
        font-size: 11pt;
        line-height: 1.45;
        -webkit-font-smoothing: antialiased;
      }

      .page {
        max-width: 8.5in;
        margin: 24px auto;
        background: var(--bg);
        padding: 0.6in 0.7in;
        box-shadow: 0 2px 18px rgba(0,0,0,0.08);
      }

      /* Sidebar de "Mis perfiles" (Fase H1): selector de perfil en lista,
         idioma y tema. Chrome de pantalla: no se imprime. */
      .mp-shell {
        display: grid;
        grid-template-columns: 220px minmax(0, 1fr);
        gap: 12px;
        align-items: start;
        max-width: var(--content-max, 1180px);
        margin: 0 auto;
        padding: 16px var(--content-pad, 20px) 32px;
      }
      .mp-side {
        border-right: 1px solid var(--rule);
        padding-right: 10px;
      }
      .mp-sec {
        font-size: 10px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 14px 0 6px 2px;
      }
      .mp-side .mp-sec:first-child { margin-top: 0; }
      .mp-profile-list { list-style: none; margin: 0; padding: 0; }
      .mp-profile-item {
        display: block;
        width: 100%;
        padding: 6px 8px;
        border: none;
        border-left: 2px solid transparent;
        border-radius: 4px;
        font-family: inherit;
        text-align: left;
        cursor: pointer;
        color: var(--ink);
        background: transparent;
        transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
      }
      .mp-profile-item:hover { background: color-mix(in srgb, var(--accent) 6%, white); }
      .mp-profile-item[aria-pressed="true"] {
        border-left-color: var(--accent);
        background: color-mix(in srgb, var(--accent) 8%, white);
      }
      .mp-profile-item:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .mp-profile-title { display: block; font-size: 12px; font-weight: 700; }
      .mp-profile-summary {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 11px;
        color: var(--muted);
        margin-top: 2px;
      }
      .mp-side .toggle, .mp-side .theme-panel { margin-top: 2px; }
      .mp-descargar {
        display: block;
        width: 100%;
        margin-top: 16px;
        padding: 8px 10px;
        border: 1px solid var(--accent);
        border-radius: 6px;
        background: var(--accent);
        color: #fff;
        font-family: inherit;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: background 150ms ease-out, transform 150ms ease-out, box-shadow 150ms ease-out;
      }
      .mp-descargar:hover { transform: translateY(-1px); box-shadow: 0 2px 6px -2px rgba(10, 20, 40, 0.18); }
      .mp-descargar:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .mp-shell .page { margin: 0 auto; }

      @media (max-width: 1000px) {
        .mp-shell { grid-template-columns: 1fr; }
        .mp-side {
          border-right: none;
          border-bottom: 1px solid var(--rule);
          padding-right: 0;
          padding-bottom: 10px;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .mp-shell *, .mp-shell *::before, .mp-shell *::after {
          transition: none !important;
          animation: none !important;
        }
      }

      .toolbar {
        margin: 0;
        /* Barra full-bleed; su contenido sigue el ritmo horizontal del chrome
           (--chrome-max / --chrome-pad, iguales en todas las rutas) y no la
           columna de contenido de cada pagina (--content-max / --content-pad):
           asi el header se ve identico al navegar entre rutas. */
        padding-inline: calc(var(--chrome-pad, 20px) + max(0px, (100% - var(--chrome-max, 1180px)) / 2));
        background: #fff;
        border-bottom: 1px solid var(--rule);
        box-shadow: 0 1px 0 rgba(10, 20, 40, 0.02), 0 8px 24px -12px rgba(10, 20, 40, 0.12);
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        min-height: 64px;
        position: sticky;
        top: 0;
        z-index: 50;
      }
      .toolbar::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 2px;
        background: linear-gradient(90deg, var(--accent), transparent 65%);
        opacity: 0.35;
        pointer-events: none;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        margin-right: 4px;
      }
      .brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 9px;
        background: var(--accent);
        color: #fff;
        font-weight: 700;
        font-size: 11pt;
        letter-spacing: 0.02em;
        box-shadow: 0 2px 6px -1px rgba(10, 20, 40, 0.25);
        transition: transform 160ms ease-out, box-shadow 160ms ease-out;
      }
      .brand:hover .brand-mark {
        transform: translateY(-1px) rotate(-2deg);
        box-shadow: 0 4px 10px -2px rgba(10, 20, 40, 0.3);
      }
      .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
      .brand-name { font-weight: 700; font-size: 10.5pt; color: var(--ink); }
      .brand-role { font-size: 8pt; color: var(--muted); letter-spacing: 0.04em; text-transform: uppercase; }
      .brand:hover .brand-name { color: var(--accent); }

      .toolbar button, .toolbar .toggle {
        font-family: inherit;
        font-size: 10pt;
        padding: 7px 12px;
        border: 1px solid var(--rule);
        background: #f7f7f7;
        color: var(--ink);
        border-radius: 6px;
        cursor: pointer;
        line-height: 1;
        transition: background 140ms ease-out, transform 140ms ease-out, box-shadow 140ms ease-out, color 140ms ease-out;
      }
      .toolbar button:hover { background: #efefef; transform: translateY(-1px); box-shadow: 0 2px 6px -2px rgba(10, 20, 40, 0.18); }
      .toolbar button:active { transform: translateY(0) scale(0.98); box-shadow: none; }
      .toolbar button:focus-visible, .brand:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .toolbar .spacer { flex: 1; }
      .toolbar .toggle { display: inline-flex; overflow: hidden; border-radius: 6px; }
      .toolbar .toggle button { border: 0; border-radius: 0; background: transparent; padding: 7px 14px; transition: background 140ms ease-out, color 140ms ease-out; }
      .toolbar .toggle button[aria-pressed="true"] { background: var(--accent); color: #fff; font-weight: 600; }
      .toolbar .toggle button:hover { transform: none; }

      /* Aviso de modo de build: no invasivo, se descarta con la x */
      .build-notice {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        max-width: 260px;
        padding: 4px 8px;
        border: 1px solid color-mix(in srgb, var(--accent) 26%, #ffffff);
        border-radius: 999px;
        background: color-mix(in srgb, var(--accent) 8%, #ffffff);
        color: #4a4f57;
        font-size: 11px;
        line-height: 1.3;
      }
      .build-notice-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .build-notice-close {
        border: 0;
        background: transparent;
        padding: 0 2px;
        font-size: 13px;
        line-height: 1;
        color: #6b7280;
        box-shadow: none;
      }
      .build-notice-close:hover { background: transparent; transform: none; box-shadow: none; color: #111827; }

      .site-nav { display: inline-flex; align-items: center; gap: 4px; }
      /* Navbar como links con subrayado (regla de UI de la Fase F): nunca pill ni
         rectangulo (eso es para acciones). El activo queda subrayado en accent. */
      .site-nav-link {
        display: inline-flex;
        align-items: center;
        min-height: 29px;
        padding: 6px 10px;
        color: var(--muted);
        background: transparent;
        font-size: 10pt;
        text-decoration: underline;
        text-decoration-color: transparent;
        text-decoration-thickness: 2px;
        text-underline-offset: 5px;
        transition: color 150ms ease, text-decoration-color 150ms ease;
      }
      .site-nav-link:hover { color: var(--ink); text-decoration-color: var(--rule); }
      .site-nav-link.active {
        color: var(--accent);
        font-weight: 600;
        text-decoration-color: var(--accent);
      }
      .site-nav-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      .lang { display: none; }
      .lang.active { display: block; }

      h1 {
        font-size: 22pt;
        margin: 0 0 2px 0;
        letter-spacing: -0.01em;
        font-weight: 700;
      }
      .titleline {
        font-size: 13pt;
        color: var(--muted);
        margin: 0 0 8px 0;
        font-weight: 600;
      }
      .contactline {
        font-size: 9.5pt;
        color: var(--muted);
        margin: 0 0 4px 0;
        word-break: break-word;
      }
      .contactline a { color: var(--muted); text-decoration: none; }
      .contactline .sep { margin: 0 6px; color: #bbb; }

      section { margin-top: 16px; }
      h2 {
        font-size: 12.5pt;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-bottom: 1.5px solid var(--ink);
        padding-bottom: 3px;
        margin: 0 0 8px 0;
        font-weight: 700;
      }
      p { margin: 0 0 8px 0; }

      .summary p { margin: 0; }

      .skills .skill-line {
        display: flex;
        gap: 8px;
        margin-bottom: 3px;
        font-size: 10pt;
      }
      .skills .skill-cat {
        flex: 0 0 145px;
        font-weight: 700;
        color: var(--ink);
      }
      .skills .skill-items { flex: 1; }

      .job-head {
        margin-bottom: 6px;
      }
      .job-head .job-role {
        font-size: 11pt;
        font-weight: 700;
      }
      .job-head .job-company {
        font-size: 10.5pt;
        font-weight: 700;
      }
      .job-head .job-dates {
        font-size: 10pt;
        color: var(--muted);
      }

      .subproject { margin-bottom: 10px; break-inside: avoid; page-break-inside: avoid; }
      .bullets li.proj-line { font-weight: 700; margin-top: 6px; }
      .bullets li.bullet-item { margin-left: 14px; }
      .bullets li.proj-url { font-size: 9.5pt; color: var(--muted); margin-left: 14px; word-break: break-all; }
      ul.bullets {
        /* Los marcadores son caracteres literales en el texto (ADR-0039 v4): el
           marker de lista CSS no se copia ni aparece en la capa de texto del PDF. */
        list-style: none;
        padding-left: 18px;
        margin: 0;
      }
      ul.bullets li {
        margin-bottom: 4px;
        font-size: 10pt;
        line-height: 1.4;
      }

      .edu-entry, .cert-entry, .proj-entry { margin-bottom: 6px; }
      .edu-head, .cert-head, .proj-head {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: baseline;
      }
      .edu-name, .cert-name, .proj-name { font-weight: 700; font-size: 10.5pt; }
      .edu-dates, .proj-meta { font-size: 9.5pt; color: var(--muted); white-space: nowrap; }
      .cert-note, .proj-desc { font-size: 10pt; }
      .edu-note { font-size: 9.5pt; color: var(--muted); margin-top: 1px; }

      .theme-panel {
        position: relative;
        font-size: 10pt;
      }
      .theme-panel > summary {
        cursor: pointer;
        padding: 7px 12px;
        border: 1px solid var(--rule);
        background: #f7f7f7;
        border-radius: 6px;
        list-style: none;
        font-family: inherit;
        line-height: 1;
        user-select: none;
      }
      .theme-panel > summary::-webkit-details-marker { display: none; }
      .theme-panel[open] > summary { background: #efefef; }
      .theme-controls {
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 6px;
        background: #fff;
        border: 1px solid var(--rule);
        border-radius: 8px;
        padding: 12px 14px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
        z-index: 20;
        min-width: 280px;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .theme-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
      }
      .theme-label {
        font-size: 9pt;
        font-weight: 700;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        flex: 0 0 70px;
      }
      .theme-presets {
        display: inline-flex;
        gap: 4px;
        flex-wrap: wrap;
      }
      .theme-presets button {
        font-family: inherit;
        font-size: 9.5pt;
        padding: 5px 10px;
        border: 1px solid var(--rule);
        background: #fafafa;
        color: var(--ink);
        border-radius: 5px;
        cursor: pointer;
        line-height: 1;
      }
      .theme-presets button[aria-pressed="true"] {
        background: var(--ink);
        color: #fff;
        border-color: var(--ink);
      }
      .theme-presets .swatch {
        display: inline-block;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        margin-right: 5px;
        vertical-align: middle;
        border: 1px solid rgba(0,0,0,0.15);
      }
      .theme-picker {
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }
      .theme-picker[hidden] { display: none; }
      .theme-picker input[type="color"] {
        width: 34px;
        height: 26px;
        padding: 0;
        border: 1px solid var(--rule);
        border-radius: 5px;
        background: transparent;
        cursor: pointer;
      }
      .theme-feedback {
        font-size: 9pt;
        font-weight: 600;
        align-self: center;
        letter-spacing: 0.02em;
      }
      .theme-feedback.error { color: #9b2020; }
      .theme-feedback.ok { color: #1f5736; }
      .theme-row label {
        font-size: 10pt;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
        white-space: nowrap;
      }
      .theme-row input[type="checkbox"] { margin: 0; }

      @page {
        margin: 0;
        size: auto;
      }

      @media print {
        :root {
          print-color-adjust: exact;
          -webkit-print-color-adjust: exact;
        }
        body { background: #fff; font-size: 11pt; margin: 0; padding: 0; }
        .toolbar, .mp-side { display: none !important; }
        .page {
          max-width: none;
          margin: 0;
          padding: 0.5in;
          -webkit-box-decoration-break: clone;
          box-decoration-break: clone;
          box-shadow: none;
          overflow: visible !important;
        }
        .lang { display: none !important; }
        .lang.active { display: block !important; }
        section { margin-top: 12px; }
        h1 { font-size: 20pt; }
        h2 { font-size: 12pt; }
        a { color: var(--ink); text-decoration: none; }
        .contactline, .job-head .job-dates, .edu-dates, .edu-note, .proj-meta, .bullets li.proj-url {
          color: var(--ink);
        }
        h1, h2, .skill-cat, .bullets li.proj-url { color: var(--accent) !important; }
        h2 { border-bottom-color: var(--accent) !important; }
      }

      /* ===== Chips/badges de postulacion (Fase F): pills solo para etiquetas ===== */
      .chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border: none;
        border-radius: 999px;
        padding: 2px 9px;
        font-size: 11px;
        color: var(--muted);
        background: color-mix(in srgb, var(--ink) 6%, var(--bg));
        white-space: nowrap;
      }
      .of-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 999px;
        padding: 2px 10px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
        text-transform: capitalize;
      }
      .of-badge-enviada {
        background: color-mix(in srgb, var(--accent) 14%, var(--bg));
        color: var(--accent);
      }
      .of-badge-confirmada {
        background: color-mix(in srgb, #1f7a4d 14%, var(--bg));
        color: #1a6540;
      }
      .of-badge-descartada {
        background: color-mix(in srgb, var(--ink) 7%, var(--bg));
        color: var(--muted);
      }
      .of-badge-borrador {
        background: transparent;
        color: var(--muted);
        border: 1px dashed var(--rule);
      }
      .of-badge-capturada {
        background: transparent;
        color: var(--accent);
        border: 1px solid var(--accent);
      }

      /* ===== Modales: overlay, caja, cabecera y formulario. Compartidos por los
         dialogos de la app (el "Descargar", p. ej.). ===== */
      .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 25, 45, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 200;
        animation: overlayFade 160ms ease-out;
      }
      @keyframes overlayFade { from { opacity: 0; } to { opacity: 1; } }
      .modal-box {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 18px 60px rgba(10, 20, 40, 0.25);
        width: min(920px, 94vw);
        max-height: 90vh;
        overflow-y: auto;
        padding: 18px 20px;
      }
      .modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
      .modal-head h3 { margin: 0; font-size: 13pt; }
      .modal-close {
        border: 1px solid var(--rule);
        background: #f7f7f7;
        border-radius: 6px;
        font-size: 13pt;
        line-height: 1;
        padding: 4px 10px;
        cursor: pointer;
      }
      .modal-close:hover { background: #eee; }

      /* Modal IA de dos columnas */
      .modal-ai { width: min(1080px, 96vw); }
      .ai-columns { display: flex; gap: 14px; }
      .ai-col { flex: 1; display: flex; flex-direction: column; min-width: 0; }
      .ai-col-title { display: flex; justify-content: space-between; align-items: center; font-size: 9.5pt; font-weight: 600; margin-bottom: 6px; }
      .ai-prompt {
        width: 100%;
        min-height: 340px;
        font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
        font-size: 8.5pt;
        line-height: 1.45;
        border: 1px solid var(--rule);
        border-radius: 8px;
        padding: 10px;
        resize: vertical;
        background: #fbfbfd;
      }
      .ai-prompt { color: #333; }

      @media print {
        .toolbar { display: none !important; }
      }
    </style>
  
  <script>
    import '../scripts/toolbar';
  </script>
</body>
</html>
