---
import type { LocalizedText, Locale } from '../schemas/profile';
import type { ResumeLocale } from '../schemas/resume';
import type { BilingualProjection } from '../lib/profile-projection';
import Layout from '../layouts/Layout.astro';
import Toolbar from './Toolbar.astro';
import { SECTION_TITLES as sectionTitles, positioningLabel, clientBlock } from '../lib/resume-sections';

interface Props {
  projections: Record<string, BilingualProjection>;
  positionings: Array<{ id: string; title: LocalizedText }>;
  brandName: LocalizedText;
  brandMark: string;
}
const { projections, positionings, brandName, brandMark } = Astro.props;

const locales: Locale[] = ['en', 'es'];
const defaultPositioning = positionings[0];

const payload = {
  projections,
  positionings: positionings.map((positioning) => ({
    id: positioning.id,
    title: positioning.title,
    label: positioningLabel(positioning.id)
  })),
  brand: { mark: brandMark, name: brandName }
};
---

<Layout title={`${brandName.en} - ${defaultPositioning.title.en}`} contentMax="1180px">
  <Toolbar brand={{ mark: brandMark, name: brandName.en, role: defaultPositioning.title.en }} />

  {/* #cv-panel-base: ancla de DOM que usan las specs de print y de tema sobre el
      CV base. Queda del tiempo de las tabs "CVs base" / "CVs adaptados", que se
      retiraron en la Fase H. */}
  <div class="mp-shell">
    {/* Sidebar de "Mis perfiles" (Fase H): selector de perfil en lista, idioma,
        tema y Descargar (dialogo reutilizable de la Tanda H3). No se imprime
        (chrome de pantalla). */}
    <aside class="mp-side" aria-label="Controles de Mis perfiles">
      <h2 class="mp-sec">Perfiles</h2>
      <ul class="mp-profile-list">
        {positionings.map((positioning) => {
          const initial = projections[positioning.id].en as ResumeLocale;
          return (
            <li>
              <button
                type="button"
                class="mp-profile-item"
                data-positioning={positioning.id}
                aria-pressed={positioning.id === defaultPositioning.id ? 'true' : 'false'}
              >
                <span class="mp-profile-title">{positioning.title.en}</span>
                <span class="mp-profile-summary">{initial.summary}</span>
              </button>
            </li>
          );
        })}
      </ul>

      <h2 class="mp-sec">Idioma</h2>
      <div class="toggle" role="group" aria-label="Language">
        <button type="button" id="btn-en" aria-pressed="true">EN</button>
        <button type="button" id="btn-es" aria-pressed="false">ES</button>
      </div>

      <h2 class="mp-sec">Tema</h2>
      <details class="theme-panel">
        <summary>Personalizar</summary>
        <div class="theme-controls">
          <div class="theme-row">
            <span class="theme-label">Accent</span>
            <div class="theme-presets" role="radiogroup" aria-label="Accent color">
              <button type="button" data-theme="navy" aria-pressed="false"><span class="swatch" style="background:#1a365d"></span>Navy</button>
              <button type="button" data-theme="teal" aria-pressed="false"><span class="swatch" style="background:#0f4c4c"></span>Teal</button>
              <button type="button" data-theme="charcoal" aria-pressed="false"><span class="swatch" style="background:#333"></span>Charcoal</button>
              <button type="button" data-theme="custom" aria-pressed="false"><span class="swatch" data-custom-swatch></span>Custom</button>
            </div>
          </div>
          <div class="theme-row">
            <label class="theme-picker" hidden>
              <span class="theme-label" style="flex:0 0 auto">Color</span>
              <input type="color" id="theme-custom-color" value="#1a365d" />
            </label>
            <span class="theme-feedback" id="theme-feedback" hidden></span>
          </div>
          <div class="theme-row">
            <span class="theme-label">Apply to</span>
            <label><input type="checkbox" data-accent="name" checked /> Name</label>
            <label><input type="checkbox" data-accent="sections" checked /> Section headings</label>
            <label><input type="checkbox" data-accent="urls" checked /> URLs</label>
            <label><input type="checkbox" data-accent="skills" checked /> Skill categories</label>
          </div>
        </div>
      </details>

      <button type="button" class="mp-descargar" data-download-open>Descargar</button>
    </aside>

    <main class="page" id="cv-panel-base">
      {positionings.map((positioning) => locales.map((key) => {
        const data = projections[positioning.id][key] as ResumeLocale;
      return (
        <article
          class="lang"
          data-lang={key}
          data-positioning={positioning.id}
          aria-hidden={key !== 'en' || positioning.id !== defaultPositioning.id}
        >
          <header>
            <h1>{data.name}</h1>
            <p class="titleline">{data.title}</p>
            <p class="contactline">
              <span>{data.contact.phone}</span><span class="sep"> • </span>
              <span>{data.contact.email}</span><span class="sep"> • </span>
              <span>{data.contact.location}</span><span class="sep"> • </span>
              <span>{data.contact.linkedin}</span><span class="sep"> • </span>
              <span>{data.contact.github}</span>
            </p>
          </header>

          <section class="summary" aria-label={sectionTitles[key].summary}>
            <h2>{sectionTitles[key].summary}</h2>
            {data.summary.split('\n\n').map((para) => <p>{para}</p>)}
          </section>

          <section class="skills" aria-label={sectionTitles[key].skills}>
            <h2>{sectionTitles[key].skills}</h2>
            {data.skills.map((skill) => (
              <div class="skill-line">
                <span class="skill-cat">{skill.category}</span>
                <span class="skill-items">{skill.items}</span>
              </div>
            ))}
          </section>

          <section aria-label={sectionTitles[key].experience}>
            <h2>{sectionTitles[key].experience}</h2>
            {data.experience.map((job) => (
              <div class="job">
                <div class="job-head">
                  <div class="job-role">{job.role}</div>
                  <div class="job-company">{job.company}</div>
                  <div class="job-dates">{job.startDate} - {job.endDate}</div>
                </div>
                {job.projects.map((project) => (
                  <div class="subproject">
                    <ul class="bullets">
                      <li class="proj-line"><span aria-hidden="true">{'\u2022 '}</span>{clientBlock(project.name, project.startDate, project.endDate, key)}</li>
                      {project.url && <li class="proj-url"><span aria-hidden="true">{'- '}</span>{project.url}</li>}
                      {project.bullets.map((bullet) => <li class="bullet-item"><span aria-hidden="true">{'- '}</span>{bullet}</li>)}
                    </ul>
                  </div>
                ))}
              </div>
            ))}
          </section>

          <section aria-label={sectionTitles[key].education}>
            <h2>{sectionTitles[key].education}</h2>
            {data.education.map((edu) => (
              <div class="edu-entry">
                <div class="edu-head">
                  <span class="edu-name">{edu.institution} - {edu.degree}</span>
                  <span class="edu-dates">{edu.startDate} - {edu.endDate}</span>
                </div>
                {edu.note && <div class="edu-note">{edu.note}</div>}
              </div>
            ))}
          </section>

          <section aria-label={sectionTitles[key].certifications}>
            <h2>{sectionTitles[key].certifications}</h2>
            {data.certifications.map((cert) => (
              <div class="cert-entry">
                <div class="cert-head">
                  <span class="cert-name">{cert.name}</span>
                </div>
                {cert.note && <div class="cert-note">{cert.note}</div>}
              </div>
            ))}
          </section>

          {data.projects.length > 0 && (
            <section aria-label={sectionTitles[key].projects}>
              <h2>{sectionTitles[key].projects}</h2>
              {data.projects.map((project) => (
                <div class="proj-entry">
                  <div class="proj-head">
                    <span class="proj-name">{project.name}</span>
                    <span class="proj-meta">{[project.url, project.date].filter(Boolean).join(' | ')}</span>
                  </div>
                  <div class="proj-desc">{project.description}</div>
                </div>
              ))}
            </section>
          )}
        </article>
      );
    }))}
    </main>
  </div>

  <script type="application/json" id="resume-data" is:inline set:html={JSON.stringify(payload)}></script>

  <script>
    import { LANG_STORAGE_KEY, POSITIONING_STORAGE_KEY } from '../scripts/storage-keys';
    import type { ResumeLocale } from '../schemas/resume';
    import type { DownloadPayload } from '../scripts/download-export';

    type Locale = 'es' | 'en';

    interface Payload {
      projections: Record<string, Record<Locale, unknown>>;
      positionings: Array<{ id: string; title: Record<Locale, string>; label?: string }>;
      brand: { mark: string; name: Record<Locale, string> };
    }

    const dataEl = document.getElementById('resume-data');
    const payload: Payload = dataEl
      ? JSON.parse(dataEl.textContent || '{}')
      : { projections: {}, positionings: [], brand: { mark: '', name: { es: '', en: '' } } };

    const defaultPositioning = payload.positionings[0]?.id ?? '';

    function readStored(key: string, allowed: string[], fallback: string): string {
      try {
        const saved = localStorage.getItem(key);
        if (saved && allowed.includes(saved)) return saved;
      } catch {
        // localStorage no disponible
      }
      return fallback;
    }

    function currentLang(): Locale {
      return readStored(LANG_STORAGE_KEY, ['es', 'en'], 'en') as Locale;
    }

    function currentPositioning(): string {
      const ids = payload.positionings.map((positioning) => positioning.id);
      return readStored(POSITIONING_STORAGE_KEY, ids, defaultPositioning);
    }

    function applyState() {
      const lang = currentLang();
      const positioning = currentPositioning();

      // Solo los articulos del CV base (tienen data-positioning): los de la isla del
      // gestor de ofertas no se tocan o se rompe su hidratacion de React.
      for (const art of document.querySelectorAll('article.lang[data-positioning]')) {
        const on =
          art.getAttribute('data-lang') === lang && art.getAttribute('data-positioning') === positioning;
        art.classList.toggle('active', on);
        art.setAttribute('aria-hidden', String(!on));
      }

      const nameEl = document.querySelector<HTMLElement>('.brand-name');
      if (nameEl) nameEl.textContent = payload.brand.name[lang] ?? payload.brand.name.en;
      const roleEl = document.querySelector<HTMLElement>('.brand-role');
      const active = payload.positionings.find((option) => option.id === positioning);
      if (roleEl && active) roleEl.textContent = active.title[lang] ?? active.title.en;

      for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-positioning]')) {
        const id = button.getAttribute('data-positioning');
        button.setAttribute('aria-pressed', String(id === positioning));
      }

      // Las entradas del sidebar llevan estructura propia: se actualizan sus
      // textos al locale activo en vez de pisar el contenido del boton.
      for (const item of document.querySelectorAll<HTMLElement>('.mp-profile-item')) {
        const id = item.getAttribute('data-positioning') ?? '';
        const option = payload.positionings.find((candidate) => candidate.id === id);
        const titleEl = item.querySelector<HTMLElement>('.mp-profile-title');
        const summaryEl = item.querySelector<HTMLElement>('.mp-profile-summary');
        if (titleEl && option) titleEl.textContent = option.title[lang] ?? option.title.en;
        const projection = payload.projections[id]?.[lang] as { summary?: string } | undefined;
        if (summaryEl) summaryEl.textContent = projection?.summary ?? '';
      }
    }

    applyState();

    document.addEventListener('toolbar:lang-change', () => applyState());
    document.addEventListener('toolbar:positioning-change', () => applyState());

    // "Descargar" del sidebar: abre el dialogo reutilizable con el CV activo
    // (posicionamiento e idioma activos; Tanda H3).
    document.querySelector<HTMLButtonElement>('[data-download-open]')?.addEventListener('click', () => {
      const lang = currentLang();
      const positioning = currentPositioning();
      const cv = payload.projections[positioning]?.[lang] as ResumeLocale | undefined;
      if (!cv) return;
      const detail: DownloadPayload = {
        name: cv.name,
        locale: lang,
        docs: [{ doc: 'cv', enabled: true, cv }]
      };
      window.dispatchEvent(new CustomEvent('download:open', { detail }));
    });
  </script>
</Layout>
