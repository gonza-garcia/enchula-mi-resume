---
/**
 * Dialogo reutilizable "Descargar" (Fase H): una sola implementacion para
 * "Mis perfiles" y /ofertas. El markup es un esqueleto; la lista de documentos
 * y formatos la arma src/scripts/download-dialog.ts contra el payload del
 * evento `download:open`. Reusa el CSS de modales de Layout.astro.
 */
---

<div class="modal-overlay" data-download-dialog hidden>
  <div class="modal-box download-box" role="dialog" aria-modal="true" aria-labelledby="download-dialog-title">
    <div class="modal-head">
      <h3 id="download-dialog-title">Descargar</h3>
      <button type="button" class="modal-close" data-download-close aria-label="Cerrar">x</button>
    </div>
    <div data-download-docs></div>
  </div>
</div>

<style is:global>
  /* Dialogo "Descargar" (Fase H). Reglas de UI: rectangulos para acciones,
     focus-visible, transiciones 150ms, prefers-reduced-motion y escala 11/12/13.
     El contenido del dialogo lo inyecta el script al abrir, por eso las reglas
     son globales. */
  .modal-overlay[hidden] { display: none !important; }
  .download-box { width: min(420px, 94vw); }
  .download-doc { border-top: 1px solid var(--rule); padding: 10px 2px; }
  .download-doc:first-child { border-top: none; padding-top: 2px; }
  .download-doc-label {
    margin: 0 0 6px;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .download-formats { display: flex; flex-wrap: wrap; gap: 8px; }
  .download-format {
    font-family: inherit;
    font-size: 11px;
    font-weight: 600;
    padding: 6px 12px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: #f7f7f7;
    color: var(--ink);
    cursor: pointer;
    transition: background 150ms ease-out, transform 150ms ease-out, box-shadow 150ms ease-out;
  }
  .download-format:hover { background: #efefef; transform: translateY(-1px); box-shadow: 0 2px 6px -2px rgba(10, 20, 40, 0.18); }
  .download-format:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .download-format:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }
  .download-hint { margin: 6px 0 0; color: var(--muted); font-size: 11px; line-height: 1.3; }
  .download-doc.is-active .download-doc-label { color: var(--accent); }
  @media (prefers-reduced-motion: reduce) {
    .download-format, .download-format:hover { transition: none; transform: none; }
  }
  /* El dialogo es chrome de pantalla: nunca se imprime (el PDF sale por la
     impresion del documento elegido, no del dialogo). */
  @media print {
    .modal-overlay { display: none !important; }
  }
</style>

<script>
  import '../scripts/download-dialog';
</script>
