---
/**
 * "Ofertas" (Fase F, variante D): la vista de resultados del pipeline como
 * producto. Sidebar de filtros (Estado, Perfil, Top matches), cards compactas y
 * visor a la derecha con las 5 vistas (Oferta original / Match report / CV
 * adaptado / Cover letter / Postulacion). La data viene de las carpetas de
 * docs/job-offers con el read model; en build generico solo entran ofertas demo
 * (ADR-0033). Sin seguimiento ni acciones de envio: el Submit de cualquier
 * postulacion lo aprieta siempre el usuario.
 */
import { marked } from 'marked';
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import OffersView from '../islands/offers-view/OffersView';
import { listOffers, readOfferDetail, parseCoverLetterFile, stripFrontmatter } from '../lib/job-offers';
import { listSources } from '../lib/job-search';
import { loadProfile, nameInitials } from '../lib/profile';
import { resumeSchema } from '../schemas/resume';
import type { OfferRow } from '../islands/offers-view/contract';

const { profile } = loadProfile();

const sources = listSources();

const rows: OfferRow[] = listOffers().map((listing) => {
  const detail = readOfferDetail(listing.slug);
  const offerRaw = detail?.offerRaw ?? '';
  const reportRaw = detail?.reportRaw ?? null;
  const coverRaw = detail?.coverLetterRaw ?? null;
  let adaptedResume: OfferRow['adaptedResume'] = null;
  if (detail?.adaptedResume) {
    const parsed = resumeSchema.safeParse(detail.adaptedResume);
    if (parsed.success) adaptedResume = parsed.data;
  }
  return {
    slug: listing.slug,
    empresa: listing.meta.empresa,
    rol: listing.meta.rol,
    fecha: listing.meta.fecha,
    url: listing.meta.url,
    urlAlternativas: listing.meta.urlAlternativas,
    modalidad: listing.meta.modalidad,
    location: listing.meta.location,
    salario: listing.meta.salario,
    recruiter: listing.meta.recruiter,
    perfiles: listing.meta.perfiles,
    fuente: listing.meta.fuente,
    barrido: listing.meta.barrido,
    idVacante: listing.meta.idVacante,
    estado: listing.estado,
    matchScore: listing.matchScore,
    hasReviewPlan: listing.hasReviewPlan,
    application: listing.application,
    offerHtml: marked.parse(stripFrontmatter(offerRaw)) as string,
    offerRaw,
    reportHtml: reportRaw ? (marked.parse(stripFrontmatter(reportRaw)) as string) : null,
    reportRaw,
    coverHtml: coverRaw ? (marked.parse(stripFrontmatter(coverRaw)) as string) : null,
    coverRaw,
    coverLocale: coverRaw ? parseCoverLetterFile(coverRaw).locale : null,
    adaptedResume,
    adaptedResumeInvalid: Boolean(detail?.adaptedResume) && !adaptedResume,
    adaptedRaw: detail?.adaptedRaw ?? null,
    applicationRaw: detail?.applicationRaw ?? null
  };
});

const positionings = profile.positionings.map((positioning) => ({
  id: positioning.id,
  title: positioning.title.en
}));
---

<Layout title={`Ofertas - ${profile.identity.name.en}`} contentMax="100%">
  {/* Navbar slim de 4 destinos (Fase F): brand + links, sin controles (idioma y tema viven en el sidebar de "Mis perfiles"). */}
  <div class="toolbar">
    <SiteNav
      brand={{
        mark: nameInitials(profile.identity.name.en),
        name: profile.identity.name.en,
        role: profile.positionings[0].title.en
      }}
    />
    <div class="spacer"></div>
  </div>

  {/* La seccion "Barridos" del pipeline vive en /fuentes (Tanda H2). */}

  <OffersView
    client:load
    rows={rows}
    positionings={positionings}
    sources={sources.map((source) => ({ id: source.id, nombre: source.nombre }))}
    profileName={profile.identity.name.en}
  />

  <style is:global>
    /* ===== Vista "Ofertas" (Fase F, variante D) =====
       Reglas de UI: pills solo para etiquetas (chips/badges), rectangulos para
       acciones (boton base + primario/secundario/ghost), segmented para las
       vistas del visor, focus-visible, transiciones 150ms, prefers-reduced-motion
       y escala tipografica 11/12/13. */
    .of-shell {
      /* Layout fluido (Tanda H2): sin tope de ancho, con los anchos de panel en
         vars (los splitters de la H2d las mueven). El visor por defecto mide lo
         mismo que la hoja del CV de Mis Perfiles (8.5in, Layout.astro) y el feed
         se queda con el resto. Cinco columnas: los splitters ocupan las dos
         columnas de 12px que hacen de gap entre paneles. El padding lateral
         comparte --content-pad con la barra (Tanda H3d: barra y contenido
         alineados; aca contentMax="100%", todo fluido). */
      --of-side-w: 180px;
      --of-viewer-w: 8.5in;
      display: grid;
      grid-template-columns:
        minmax(140px, var(--of-side-w))
        12px
        minmax(280px, 1fr)
        12px
        minmax(340px, var(--of-viewer-w));
      gap: 0;
      align-items: start;
      margin: 0 auto;
      padding: 16px var(--content-pad, 20px) 32px;
      color: var(--ink);
    }

    /* ---- Splitters de paneles (Tanda H2d): handles verticales invisibles
       sobre el gap, con drag o flechas del teclado (los clamps viven en la
       isla). Solo desktop: el layout apilado no tiene paneles lado a lado. ---- */
    .of-splitter {
      align-self: stretch;
      cursor: col-resize;
      border-radius: 4px;
      background: transparent;
      touch-action: none;
      transition: background-color 150ms ease;
    }
    .of-splitter:hover,
    .of-splitter.dragging {
      background: color-mix(in srgb, var(--accent) 30%, transparent);
    }
    .of-splitter:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }

    /* ---- Boton base + variantes (rectangulos: acciones) ---- */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      min-height: 32px;
      border-radius: 6px;
      border: 1px solid var(--rule);
      background: var(--bg);
      color: var(--ink);
      padding: 6px 12px;
      font-family: inherit;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      white-space: nowrap;
      text-decoration: none;
      transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
    }
    .btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .btn.primary {
      background: var(--accent);
      color: var(--bg);
      border-color: var(--accent);
    }
    .btn.primary:hover {
      background: color-mix(in srgb, var(--accent) 85%, var(--ink));
      color: var(--bg);
    }
    .btn.secondary {
      background: var(--bg);
    }
    .btn.ghost {
      border-color: transparent;
      color: var(--muted);
      background: transparent;
    }
    .btn.ghost:hover {
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 8%, var(--bg));
    }
    .btn:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    /* ---- Pills: solo etiquetas (chips y badges de postulacion). Sus estilos
       viven globales en Layout.astro para compartirlos con el gestor de ofertas. ---- */

    /* ---- Sidebar de filtros ---- */
    .of-side {
      border-right: 1px solid var(--rule);
      padding-right: 10px;
    }
    .of-sec {
      display: flex;
      align-items: center;
      gap: 4px;
      width: 100%;
      padding: 0;
      border: none;
      background: none;
      font-family: inherit;
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 14px 0 6px 2px;
      text-align: left;
      cursor: pointer;
    }
    .of-sec:hover {
      color: var(--ink);
    }
    .of-sec:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    .of-group:first-child .of-sec {
      margin-top: 0;
    }
    .of-chevron {
      display: inline-block;
      font-size: 13px;
      line-height: 1;
      transition: transform 150ms ease;
    }
    .of-chevron.open {
      transform: rotate(90deg);
    }
    .of-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      padding: 6px 8px;
      border: none;
      border-left: 2px solid transparent;
      border-radius: 4px;
      font-family: inherit;
      font-size: 12px;
      text-align: left;
      cursor: pointer;
      color: var(--ink);
      background: transparent;
      transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
    }
    .of-item:hover {
      background: color-mix(in srgb, var(--ink) 6%, var(--bg));
    }
    .of-item.on {
      background: color-mix(in srgb, var(--accent) 10%, var(--bg));
      border-left-color: var(--accent);
      font-weight: 700;
    }
    .of-item.muted {
      color: var(--muted);
    }
    .of-item:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    .of-count {
      font-size: 11px;
      color: var(--muted);
      font-variant-numeric: tabular-nums;
    }

    /* ---- Feed de cards compactas ---- */
    .of-feed {
      min-width: 0;
    }
    .of-card {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      width: 100%;
      border: 1px solid var(--rule);
      border-radius: 6px;
      padding: 10px;
      margin-bottom: 8px;
      background: var(--bg);
      font-family: inherit;
      text-align: left;
      cursor: pointer;
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }
    .of-card:hover {
      border-color: var(--accent);
    }
    .of-card.sel {
      border-color: var(--accent);
      box-shadow: 0 0 0 1px var(--accent);
    }
    .of-card:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    .of-score {
      min-width: 34px;
      height: 34px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 12px;
      border: 2px solid #1f7a4d;
      color: #1f7a4d;
      flex: 0 0 auto;
    }
    .of-score.mid {
      border-color: var(--accent);
      color: var(--accent);
    }
    .of-card-body {
      display: block;
      flex: 1;
      min-width: 0;
    }
    .of-card-title {
      display: block;
      font-size: 13px;
      font-weight: 700;
      margin: 0 0 2px 0;
    }
    .of-card-title .muted {
      font-weight: 400;
    }
    .of-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
    }
    .of-row.tight {
      gap: 5px;
      margin: 6px 0;
    }
    .of-row.spread {
      justify-content: space-between;
    }
    .of-clamp {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 11px;
      color: var(--muted);
      margin: 6px 0 0 0;
    }

    /* ---- Visor a la derecha ---- */
    .of-viewer {
      border: 1px solid var(--rule);
      border-radius: 6px;
      background: var(--bg);
      min-width: 0;
      position: sticky;
      top: 10px;
    }
    .of-viewer-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      padding: 10px 12px;
      border-bottom: 1px solid var(--rule);
    }
    .of-segmented {
      display: inline-flex;
      gap: 2px;
      padding: 2px;
      border: 1px solid var(--rule);
      border-radius: 6px;
      background: var(--bg);
    }
    .of-segmented button {
      border: none;
      border-radius: 4px;
      padding: 5px 11px;
      font-family: inherit;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      background: transparent;
      color: var(--muted);
      transition: background-color 150ms ease, color 150ms ease;
    }
    .of-segmented button:hover {
      color: var(--ink);
    }
    .of-segmented button.on {
      background: color-mix(in srgb, var(--accent) 12%, var(--bg));
      color: var(--accent);
      font-weight: 700;
    }
    .of-segmented button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    .of-menu-wrap {
      position: relative;
    }
    .of-menu-btn {
      padding: 6px 8px;
    }
    .of-menu {
      position: absolute;
      right: 0;
      top: calc(100% + 4px);
      z-index: 20;
      min-width: 180px;
      padding: 4px;
      background: var(--bg);
      border: 1px solid var(--rule);
      border-radius: 6px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .of-menu-item {
      display: block;
      width: 100%;
      text-align: left;
      border: none;
      border-radius: 4px;
      background: transparent;
      padding: 8px 10px;
      font-family: inherit;
      font-size: 12px;
      color: var(--ink);
      cursor: pointer;
      text-decoration: none;
      transition: background-color 150ms ease, color 150ms ease;
    }
    .of-menu-item:hover {
      background: color-mix(in srgb, var(--accent) 10%, var(--bg));
      color: var(--accent);
    }
    .of-menu-item.disabled {
      color: var(--muted);
      cursor: not-allowed;
    }
    .of-menu-item:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    .of-pane {
      padding: 12px 14px;
      /* Alto acotado por el viewport (Tanda H2): el visor es sticky, asi que el
         panel aprovecha la pantalla en vez de un tope fijo de 620px. */
      max-height: calc(100vh - 96px);
      overflow: auto;
      font-size: 12px;
    }
    .of-empty {
      padding: 24px 12px;
      text-align: center;
      color: var(--muted);
      font-size: 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    .of-empty-line {
      margin: 8px 0;
    }
    .muted {
      color: var(--muted);
    }
    .tiny {
      font-size: 11px;
    }
    /* Misma escala que .tiny, para los bloques de datos de la vista Postulacion
       (la clase ya se usaba sin regla y los textos salian con el tamano base). */
    .of-tiny {
      font-size: 11px;
    }

    /* ---- Prosa del markdown (oferta original, cover letter) ---- */
    .of-prose h1,
    .of-prose h2,
    .of-prose h3,
    .of-prose h4 {
      font-size: 13px;
      margin: 12px 0 6px 0;
    }
    .of-prose p,
    .of-prose ul,
    .of-prose ol {
      font-size: 12px;
      margin: 6px 0;
      line-height: 1.5;
    }
    .of-prose ul,
    .of-prose ol {
      padding-left: 18px;
    }
    .of-prose a {
      color: var(--accent);
    }
    .of-prose code {
      font-size: 11px;
      background: color-mix(in srgb, var(--ink) 6%, var(--bg));
      padding: 1px 4px;
      border-radius: 3px;
    }

    /* ---- Vista "Postulacion" ---- */
    .of-meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 8px;
      margin: 10px 0;
    }
    .of-meta-grid div {
      border: 1px solid var(--rule);
      border-radius: 6px;
      padding: 7px 9px;
      background: var(--bg);
      font-size: 12px;
    }
    .of-meta-grid span {
      display: block;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted);
    }
    .of-quote {
      border-left: 3px solid #1f7a4d;
      background: color-mix(in srgb, var(--ink) 5%, var(--bg));
      padding: 8px 10px;
      border-radius: 4px;
      font-family: monospace;
      font-size: 11px;
      margin-top: 8px;
    }

    /* ---- Vista "CV adaptado" (ATS v4, tipografia fina de panel) ----
       Mismo markup que el CV base (Resume.astro): aca solo se acota la
       tipografia al panel del visor, sin tocar la capa de texto ATS. */
    .of-cv {
      font-size: 11px;
      line-height: 1.45;
    }
    .of-cv h1 {
      font-size: 15px;
      margin: 0 0 2px 0;
      letter-spacing: -0.01em;
      font-weight: 700;
    }
    .of-cv .titleline {
      font-size: 12px;
      color: var(--muted);
      margin: 0 0 6px 0;
      font-weight: 600;
    }
    .of-cv .contactline {
      font-size: 10px;
      color: var(--muted);
      margin: 0 0 4px 0;
      word-break: break-word;
    }
    .of-cv .contactline .sep { margin: 0 4px; color: #bbb; }
    .of-cv section { margin-top: 12px; }
    .of-cv h2 {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-bottom: 1.5px solid var(--ink);
      padding-bottom: 3px;
      margin: 0 0 6px 0;
      font-weight: 700;
    }
    .of-cv p { margin: 0 0 6px 0; }
    .of-cv .summary p { margin: 0; }
    .of-cv .skills .skill-line {
      display: flex;
      gap: 8px;
      margin-bottom: 3px;
      font-size: 10.5px;
    }
    .of-cv .skills .skill-cat { flex: 0 0 110px; font-weight: 700; color: var(--ink); }
    .of-cv .skills .skill-items { flex: 1; }
    .of-cv .job-head { margin-bottom: 4px; }
    .of-cv .job-head .job-role { font-size: 11.5px; font-weight: 700; }
    .of-cv .job-head .job-company { font-size: 11px; font-weight: 700; }
    .of-cv .job-head .job-dates { font-size: 10px; color: var(--muted); }
    .of-cv .subproject { margin-bottom: 8px; break-inside: avoid; page-break-inside: avoid; }
    .of-cv ul.bullets {
      /* Marcadores literales en el texto (ADR-0039 v4), igual que el CV base. */
      list-style: none;
      padding-left: 16px;
      margin: 0;
    }
    .of-cv ul.bullets li { margin-bottom: 3px; font-size: 10.5px; line-height: 1.4; }
    .of-cv .bullets li.proj-line { font-weight: 700; margin-top: 5px; }
    .of-cv .bullets li.bullet-item { margin-left: 12px; }
    .of-cv .bullets li.proj-url { font-size: 9.5px; color: var(--muted); margin-left: 12px; word-break: break-all; }
    .of-cv .edu-entry, .of-cv .cert-entry, .of-cv .proj-entry { margin-bottom: 5px; }
    .of-cv .edu-head, .of-cv .cert-head, .of-cv .proj-head {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: baseline;
    }
    .of-cv .edu-name, .of-cv .cert-name, .of-cv .proj-name { font-weight: 700; font-size: 11px; }
    .of-cv .edu-dates, .of-cv .proj-meta { font-size: 9.5px; color: var(--muted); white-space: nowrap; }
    .of-cv .cert-note, .of-cv .proj-desc { font-size: 10.5px; }
    .of-cv .edu-note { font-size: 9.5px; color: var(--muted); margin-top: 1px; }

    /* Copias de impresion (Tanda H3c): el dialogo "Descargar" emite por print
       solo el documento elegido (body[data-print-doc]), sin mover la vista del
       visor. Chrome de pantalla: invisible arriba de la pantalla. */
    .of-print-set { display: none; }

    @media print {
      .of-shell { display: block; padding: 0; }
      .of-side, .of-feed, .of-viewer, .of-splitter { display: none !important; }
      .of-print-set { display: none; padding: 0.5in; }
      body[data-print-doc="oferta"] .of-print-set,
      body[data-print-doc="cv"] .of-print-set,
      body[data-print-doc="cover"] .of-print-set { display: block; }
      .of-print-copy { display: none; }
      body[data-print-doc="oferta"] .of-print-copy[data-print-copy="oferta"],
      body[data-print-doc="cv"] .of-print-copy[data-print-copy="cv"],
      body[data-print-doc="cover"] .of-print-copy[data-print-copy="cover"] { display: block; }
    }

    @media (max-width: 1000px) {
      .of-shell {
        grid-template-columns: 1fr;
      }
      .of-splitter {
        display: none;
      }
      .of-side {
        border-right: none;
        border-bottom: 1px solid var(--rule);
        padding-bottom: 10px;
      }
      .of-viewer {
        position: static;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .of-shell *,
      .of-shell *::before,
      .of-shell *::after,
      .modal-overlay * {
        transition: none !important;
        animation: none !important;
      }
    }
  </style>
</Layout>
