---
/**
 * "Fuentes" (Fase G, ADR-0043): el catalogo de fuentes de busqueda del pipeline.
 * Por fuente: tipo, playbook resumido (como buscar, herramientas, quirks),
 * ofertas historicas salidas de ahi y stats (ultimo barrido, capturadas,
 * descartadas). Cada tarjeta esta colapsada por defecto (Tanda H2): se ve el
 * header con sus chips y las stats, y al expandir el playbook y las ofertas.
 * La data viene de docs/job-search con el read model; en build generico solo
 * entran fuentes demo (ADR-0033). Los barridos reales son dato del usuario y
 * nunca viajan al staging ni al repo publico.
 */
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import { listOffers } from '../lib/job-offers';
import { listSources, listSweeps } from '../lib/job-search';
import { loadProfile, nameInitials } from '../lib/profile';

const { profile } = loadProfile();

const sources = listSources();
const sweeps = listSweeps();
const rows = listOffers();
const sourceName = (id: string) => sources.find((source) => source.id === id)?.nombre ?? id;

const statsFor = (sourceId: string) => {
  const capturadas = rows.filter((listing) => listing.meta.fuente === sourceId);
  const vacantes = sweeps.flatMap((sweep) => sweep.vacantes).filter((vacante) => vacante.sourceId === sourceId);
  const descartadas = vacantes.filter((vacante) => vacante.estado === 'descartada').length;
  const ultimoBarrido = sweeps.find((sweep) => sweep.fuentes.some((entry) => entry.sourceId === sourceId))?.fecha ?? null;
  return { capturadas, descartadas, ultimoBarrido };
};
---

<Layout title={`Fuentes - ${profile.identity.name.en}`}>
  {/* Navbar slim de 5 destinos (Fase F/G): brand + links, sin controles (idioma y tema viven en el sidebar de "Mis perfiles"). */}
  <div class="toolbar">
    <SiteNav
      brand={{
        mark: nameInitials(profile.identity.name.en),
        name: profile.identity.name.en,
        role: profile.positionings[0].title.en
      }}
    />
    <div class="spacer"></div>
  </div>

  <main class="fuentes">
    <h1>Fuentes</h1>
    <p class="fuentes-intro">
      De dónde salen las ofertas: cada fuente tiene su tipo y su playbook de extracción
      (cómo buscar ahí, qué herramientas usar y los quirks conocidos). Cada barrido sobre
      una fuente se registra con su fecha, sus números y las particularidades nuevas que
      mejoran el playbook. Las ofertas capturadas quedan vinculadas a su fuente y a su id
      de vacante, para saber en el próximo barrido si algo ya se capturó o ya se postuló.
    </p>

    {sources.map((source) => {
      const stats = statsFor(source.id);
      return (
        <details class="fuente-card" id={`fuente-${source.id}`}>
          <summary class="fuente-head">
            <h2>{source.nombre}</h2>
            <span class="chip">{source.tipo}</span>
            {source.prioridad && <span class="chip fuente-prio">prioritaria</span>}
            <span class={`chip${source.activa === false ? ' fuente-off' : ''}`}>
              {source.activa === false ? 'inactiva' : 'activa'}
            </span>
            {source.demo && <span class="chip">demo</span>}
            {source.url && (
              <a class="fuente-url" href={source.url} target="_blank" rel="noreferrer">{source.url}</a>
            )}
            <span class="fuente-chevron" aria-hidden="true">›</span>
            <span class="fuente-stats">
              <span class="fuente-stat">
                <span class="fuente-stat-label">Último barrido</span>
                <span class="fuente-stat-value">{stats.ultimoBarrido ?? 'sin barridos'}</span>
              </span>
              <span class="fuente-stat">
                <span class="fuente-stat-label">Ofertas capturadas</span>
                <span class="fuente-stat-value">{stats.capturadas.length}</span>
              </span>
              <span class="fuente-stat">
                <span class="fuente-stat-label">Vacantes descartadas</span>
                <span class="fuente-stat-value">{stats.descartadas}</span>
              </span>
            </span>
          </summary>

          <section class="fuente-playbook">
            <h3>Cómo actuar</h3>
            <p><strong>Buscar:</strong> {source.playbook.buscar}</p>
            <p><strong>Herramientas:</strong> {source.playbook.herramientas.join(' → ') || '—'}</p>
            <p><strong>Quirks:</strong></p>
            <ul>
              {source.playbook.quirks.map((quirk) => <li>{quirk}</li>)}
            </ul>
            {source.notas && <p class="fuentes-notas">{source.notas}</p>}
          </section>

          <section class="fuente-historial">
            <h3>Ofertas de esta fuente</h3>
            {stats.capturadas.length === 0 ? (
              <p class="fuentes-empty">Todavía no se capturaron ofertas de esta fuente.</p>
            ) : (
              <ul>
                {stats.capturadas.map((listing) => (
                  <li>
                    <a href={`/ofertas/?oferta=${listing.slug}`}>
                      {listing.meta.empresa} - {listing.meta.rol}
                    </a>
                    <span class="chip">
                      {listing.application ? `postulación: ${listing.application.estado}` : listing.estado}
                    </span>
                    <span class="fuentes-fecha">{listing.meta.fecha}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        </details>
      );
    })}

    {sources.length === 0 && (
      <p class="fuentes-empty">
        Sin fuentes configuradas. Se registran en <code>docs/job-search/sources/</code>
        (una por archivo, con su playbook).
      </p>
    )}

    {/* Barridos (Fase G, movido a /fuentes en la Tanda H2): historial del
        pipeline de busqueda. Colapsado por defecto: el detalle vive aca y las
        ofertas capturadas en su tarjeta de fuente. */}
    {sweeps.length > 0 && (
      <details class="sweeps">
        <summary>
          Barridos
          <span class="muted tiny">
            {sweeps.length} registrado{sweeps.length === 1 ? '' : 's'} - ultimo {sweeps[0].fecha}
          </span>
        </summary>
        <div class="sweeps-body">
          {sweeps.map((sweep) => (
            <article class="sweep">
              <header class="sweep-head">
                <strong>{sweep.fecha}</strong>
                <span class="muted tiny">{sweep.id}</span>
                <span class="sweep-chips">
                  {sweep.fuentes.map((entry) => (
                    <span class="chip">{sourceName(entry.sourceId)}</span>
                  ))}
                </span>
              </header>
              <p class="sweep-chips">
                <span class="chip">nuevas: {sweep.vacantes.filter((v) => v.estado === 'nueva').length}</span>
                <span class="chip">capturadas: {sweep.capturadas.length}</span>
                <span class="chip">
                  ya postuladas: {sweep.vacantes.filter((v) => v.estado === 'ya postulada').length}
                </span>
                <span class="chip">
                  descartadas: {sweep.vacantes.filter((v) => v.estado === 'descartada').length}
                </span>
              </p>
              <ul class="sweep-vacantes">
                {sweep.vacantes.map((vacante) => (
                  <li>
                    <span class={`of-badge ${
                      vacante.estado === 'descartada'
                        ? 'of-badge-descartada'
                        : vacante.estado === 'ya postulada'
                          ? 'of-badge-enviada'
                          : vacante.estado === 'capturada'
                            ? 'of-badge-confirmada'
                            : 'of-badge-borrador'
                    }`}>{vacante.estado}</span>
                    {vacante.empresa ? `${vacante.empresa} - ` : ''}
                    {vacante.titulo}
                    {vacante.motivo && <span class="muted"> — {vacante.motivo}</span>}
                  </li>
                ))}
              </ul>
              {sweep.particularidades.length > 0 && (
                <details class="sweep-notes">
                  <summary>Particularidades del proceso</summary>
                  <ul>
                    {sweep.particularidades.map((nota) => (
                      <li>{nota}</li>
                    ))}
                  </ul>
                </details>
              )}
            </article>
          ))}
        </div>
      </details>
    )}
  </main>
</Layout>

<style>
  .fuentes {
    max-width: 1100px;
    margin: 0 auto;
    padding: 16px;
  }
  .fuentes h1 {
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .fuentes-intro {
    max-width: 70ch;
    font-size: 13px;
    line-height: 1.5;
  }
  .fuente-card {
    border: 1px solid var(--border, #d9d9d9);
    border-radius: 8px;
    padding: 12px 16px;
    margin: 16px 0;
  }
  /* Summary del details: header + stats visibles con la tarjeta colapsada
     (Tanda H2). El contenido (playbook y ofertas) queda bajo el pliegue. */
  .fuente-head {
    display: flex;
    gap: 8px;
    align-items: baseline;
    flex-wrap: wrap;
    cursor: pointer;
    list-style: none;
  }
  .fuente-head::-webkit-details-marker {
    display: none;
  }
  .fuente-head h2 {
    font-size: 13px;
  }
  .fuente-chevron {
    margin-left: auto;
    font-size: 14px;
    line-height: 1;
    transition: transform 150ms ease;
  }
  .fuente-card[open] .fuente-chevron {
    transform: rotate(90deg);
  }
  .fuente-off {
    opacity: 0.6;
  }
  .fuente-prio {
    font-weight: 600;
  }
  .fuente-url {
    font-size: 11px;
    word-break: break-all;
  }
  .fuente-stats {
    flex-basis: 100%;
    display: flex;
    gap: 24px;
    margin: 10px 0;
  }
  .fuente-stat-label {
    display: block;
    font-size: 11px;
    opacity: 0.7;
  }
  .fuente-stat-value {
    display: block;
    font-size: 13px;
    font-weight: 600;
  }
  .fuente-playbook h3,
  .fuente-historial h3 {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 10px 0 4px;
  }
  .fuente-playbook p,
  .fuente-playbook li {
    font-size: 12px;
    line-height: 1.5;
  }
  .fuente-historial ul {
    list-style: none;
    padding: 0;
  }
  .fuente-historial li {
    display: flex;
    gap: 8px;
    align-items: baseline;
    font-size: 12px;
    margin: 4px 0;
    flex-wrap: wrap;
  }
  .fuentes-fecha {
    font-size: 11px;
    opacity: 0.7;
  }
  .fuentes-notas {
    font-style: italic;
  }
  .fuentes-empty {
    font-size: 12px;
    opacity: 0.8;
  }

  /* ===== Barridos (Fase G, movido de /ofertas en la Tanda H2) ===== */
  .sweeps {
    max-width: 1100px;
    margin: 16px 0 0;
    border: 1px solid var(--border, #d9d9d9);
    border-radius: 8px;
    padding: 8px 12px;
  }
  .sweeps > summary {
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  .sweep {
    border-top: 1px solid var(--border, #d9d9d9);
    padding: 10px 0;
  }
  .sweep-head {
    display: flex;
    gap: 10px;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .sweep-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    align-items: center;
    margin: 6px 0;
  }
  .sweep-vacantes {
    margin: 8px 0 0;
    padding-left: 18px;
    font-size: 12px;
  }
  .sweep-vacantes li {
    margin: 3px 0;
  }
  .sweep-notes {
    margin-top: 8px;
    font-size: 12px;
  }
  .sweep-notes > summary {
    cursor: pointer;
  }
  .muted {
    color: var(--muted);
  }
  .tiny {
    font-size: 11px;
  }

  @media (prefers-reduced-motion: reduce) {
    .fuente-chevron {
      transition: none;
    }
  }
</style>
